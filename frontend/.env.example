# Frontend dev: point at the API. Leave empty for offline localStorage mode.
VITE_API_URL=http://localhost:4000

# Vercel + Railway (proxied through frontend/vercel.json):
#   VITE_API_URL=/
# This keeps requests same-origin so auth cookies remain first-party.
# For separate custom domains (app.example.com + api.example.com), set the
# full API origin instead, e.g. https://api.example.com
