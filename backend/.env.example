# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# PostgreSQL connection string (Docker Compose dev default below)
DATABASE_URL=postgres://applyzen:applyzen_dev@127.0.0.1:5432/applyzen
# Set true when the provider requires TLS (Heroku Postgres, most managed DBs).
DATABASE_SSL=false

# Strong random secrets (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ACCESS_TOKEN_SECRET=change-me-to-64-hex-chars-min-32-bytes
REFRESH_TOKEN_PEPPER=change-me-optional-extra-pepper-for-refresh-hashes

# Comma-separated browser origins (no trailing slash). Required for CORS + CSRF.
# Production requires this to be set. Add every origin you serve the UI from.
FRONTEND_ORIGIN=http://localhost:5173
# Optional wildcard patterns for ephemeral preview URLs, comma-separated.
# Example: https://applyzen-*-your-team.vercel.app
FRONTEND_ORIGIN_PATTERNS=

# Express "trust proxy" hops. 1 = Railway's edge (default).
# Behind Vercel -> Railway, use 2 so rate limiting sees the real client IP.
TRUST_PROXY=1

# Cookie security: true in production (HTTPS). Leave false for local http.
COOKIE_SECURE=false

# Optional LLM analysis provider (OpenAI-compatible chat completions).
# When unset, POST /api/analyses uses the labeled deterministic heuristic engine.
# DeepSeek example (create a key at https://platform.deepseek.com/api_keys):
#   LLM_API_URL=https://api.deepseek.com
#   LLM_API_KEY=sk-...
#   LLM_MODEL=deepseek-chat   # note: deepseek-reasoner does not support JSON output mode
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=25000
